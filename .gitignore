# Dependencies
node_modules/

# Build output
dist/
dist-ssr/

# SECURITY: Source maps (never commit — exposes source code)
*.map
*.js.map
*.css.map

# Environment files
.env
.env.*
!.env.example

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Gstack
.gstack/

# OS files
Thumbs.db

# SECURITY: Wrangler cache (contains account tokens)
.wrangler/

# SECURITY: SQL dumps and backups
*.sql.bak
*.sql.dump
*.db.bak

# SECURITY: Lock files that could leak dependency versions
package-lock.json.bak
yarn.lock.bak
