# Supabase
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_publishable_key_here

# E2E Tests
E2E_TEST_EMAIL=test@test.com
E2E_TEST_PASSWORD=your_test_password_here

# Scripts (seed, cleanup, export)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_publishable_key_here
SEED_TENANT_ID=00000000-0000-0000-0000-000000000001
SEED_EMAIL=test@test.com
SEED_PASSWORD=your_seed_password_here

# Sentry (error monitoring)
VITE_SENTRY_DSN=

# Mirror Daemon
MIRROR_DAEMON_EMAIL=daemon@yourcompany.com
MIRROR_DAEMON_PASSWORD=your_daemon_password_here
MIRROR_ENCRYPTION_KEY=your_encryption_key_here

# Resend (transactional email — password resets, notifications, receipts)
# Sign up at https://resend.com — free tier: 3,000 emails/month
# SEC-04: Ne JAMAIS préfixer les secrets avec VITE_ — ils seraient compilés dans le bundle.
# Les emails partent depuis les edge functions, pas depuis le navigateur.
RESEND_FROM_EMAIL=noreply@onusuite.com
RESEND_API_KEY=re_your_api_key_here

# Cloudflare R2 (file storage — invoices, attachments, documents)
# Configure in Cloudflare dashboard → R2 → Create bucket
# SEC-04: VITE_R2_PUBLIC_URL est OK (URL publique), mais les clés ne doivent
# jamais être préfixées VITE_.
VITE_R2_PUBLIC_URL=https://pub-xxxxx.r2.dev
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key
R2_SECRET_ACCESS_KEY=your_r2_secret_key
R2_BUCKET_NAME=onusuite-files

# Black Forest Labs (brand asset generation — local scripts only, never exposed client-side)
# Sign up at https://bfl.ai — used by scripts/brand-assets/generate.mjs
BFL_API_KEY=your_bfl_api_key_here
