{
  "$schema": "https://unpkg.com/knip@6.35.1/schema.json",
  "entry": [
    "src/main.tsx",
    "src/App.tsx",
    "e2e/**/*.ts",
    "vitest.screen.config.ts",
    "src/__screen__/setup.ts",
    "src/__screen__/*.screen.ts",
    "scripts/**/*.mjs",
    "scripts/**/*.cjs",
    "scripts/**/*.ts",
    "mirror-daemon/daemon.mjs",
    "run-sql-migrations.mjs",
    "public/sw.js"
  ],
  "project": [
    "src/**/*.{ts,tsx}",
    "e2e/**/*.ts",
    "scripts/**/*.{mjs,cjs,ts}"
  ],
  "ignore": [
    "src/types/database-generated.ts",
    "src/vite-env.d.ts"
  ],
  "ignoreBinaries": [
    "ts-node"
  ],
  "ignoreDependencies": [
    "tailwindcss"
  ]
}
