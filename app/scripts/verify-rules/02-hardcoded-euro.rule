# rule: Hardcoded € symbol
# severity: error
# pattern: € character in .tsx/.ts files
# fix: Use formatCurrency() from useLocale hook

RULE_NAME="Hardcoded €"
RULE_DESC="Hardcoded € symbol (use formatCurrency)"
RULE_SEVERITY="error"
RULE_GREP_PATTERN="€"
RULE_GREP_INCLUDES="--include=*.tsx --include=*.ts"
RULE_GREP_PATHS="src/pages/ src/components/ src/lib/"
RULE_GREP_EXCLUDES="node_modules|\.test\.|formatCurrency|locales/|maeParser|LandingPage"
