# rule: `any` type annotations (not just `as any` casts)
# severity: warning
# pattern: : any or <any> or Array<any>
# fix: Replace with proper TypeScript types

RULE_NAME="any types"
RULE_DESC="Explicit any type annotations (replace with proper types)"
RULE_SEVERITY="warning"
RULE_USE_MULTI_PATTERN=true
RULE_GREP_PATTERNS=(
  ": any"
  "Array<any>"
  "<any>"
)
RULE_GREP_INCLUDES="--include=*.ts --include=*.tsx"
RULE_GREP_PATHS="src/pages/ src/components/ src/lib/"
RULE_GREP_EXCLUDES="node_modules|\.test\.|__tests__|as any|catch.*err.*any|error.*any"
